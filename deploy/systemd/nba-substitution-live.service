[Unit]
Description=Timberwolves live substitution prediction
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=unclephil
WorkingDirectory=/home/unclephil/nba-substitution-prediction-v2
EnvironmentFile=/home/unclephil/nba-substitution-prediction-v2/.env
ExecStart=/home/unclephil/nba-substitution-prediction-v2/venv/bin/python -u -m src.live.watch_today --discord --scoreboard-interval 60 --game-interval 30
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target